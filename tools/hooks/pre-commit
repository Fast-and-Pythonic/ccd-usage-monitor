#!/bin/sh
# Refuses a commit that the project's own checks would refuse, so they are
# enforced rather than remembered (A26, A32). Enabled once per clone with
#
#    git config core.hooksPath tools/hooks
#
# The checks run on the working tree, not on the staged snapshot: stage what
# you mean to commit, or a half-staged file is judged by its other half.

set -e
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -qE '\.rs$|^Cargo\.(toml|lock)$|^rustfmt\.toml$'; then
   echo "pre-commit: cargo fmt --check"
   cargo fmt --check || {
      echo "pre-commit: run 'cargo fmt' and stage the result" >&2
      exit 1
   }
   echo "pre-commit: cargo clippy --all-targets -- -D warnings"
   cargo clippy --quiet --all-targets -- -D warnings || {
      echo "pre-commit: clippy has findings; fix them rather than allow them" >&2
      exit 1
   }
fi

# The documentation standard lives outside this repository. Where it is not
# checked out beside it, say so and let the commit through: a contributor
# without it has nothing to run. "Beside it" means beside the main checkout:
# a linked worktree sits deeper, under .claude/worktrees/<name>/, and its
# own parent holds no standard. The common git dir is the main checkout's
# .git, whichever tree commits.
main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
std="${AI_DOCS_STANDARD:-$main/../0_project-workbook-method}"

if printf '%s\n' "$staged" | grep -qE '^project-workbook/|^AGENTS\.md$'; then
   if [ -f "$std/tools/lint_workbook.py" ]; then
      echo "pre-commit: project-workbook lint and index check"
      python "$std/tools/lint_workbook.py" --root . --docs project-workbook --profile engineering --tier M
      python "$std/tools/make_index.py" --root . --docs project-workbook --check
   else
      echo "pre-commit: Project Workbook standard not found at $std; docs not checked" >&2
   fi
fi

# Not a gate: when code is staged and project-workbook/ is not, print the update
# triggers of the standard's RULES.md section 2, while the entry can still join
# this commit.
if [ -f "$std/tools/check_triggers.py" ]; then
   python "$std/tools/check_triggers.py" || true
fi
