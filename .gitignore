/target

# The data folder (A28): machine state, not project template — except the
# theme, which is worth keeping in history since it's hand-tuned.
/settings/*
!/settings/theme.slint

# The type declarations the Claude Code engine lays into the mod at each load.
/mod/.claude-plugin/types/

# turn-meter: the engine's type declarations, and the per-session spend journals (A38).
/turn-meter/.claude-plugin/types/
/turn-meter/data/
