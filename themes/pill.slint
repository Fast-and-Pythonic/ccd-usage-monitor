// The pill, and the panel that opens under it.
//
// This file is the widget's whole appearance. It is compiled into the binary
// as a fallback and written to `%APPDATA%\ccd-usage-monitor\theme.slint` on
// first run; after that the copy on disk is what loads, so everything here can
// be changed without a Rust toolchain.
//
// What this file does NOT decide, on purpose:
//
//   * **What the figures say.** Every string arrives already worded and in the
//     right language. A theme that computed a percentage could disagree with
//     the one the program publishes over `--serve`.
//   * **What a colour means.** `ink` on a cell is already resolved — the
//     program read the palette below, worked out where the figure sits on the
//     ramp, and handed back a brush. The palette is yours; which of its
//     colours a figure gets is not.
//   * **How the window behaves.** No `no-frame`, no `always-on-top`. Those are
//     applied by the program over the window handle, so that a broken theme
//     cannot produce a window that is impossible to close or to drag.
//
// The program sets only the properties this file declares and binds only the
// callbacks it declares, so a theme written against an older version keeps
// working with fewer of them rather than failing.

// How a cell is set. The program sends a role, not a font, so changing the
// typeface here changes it everywhere it means the same thing.
//   0 — the large percentages
//   1 — countdowns, day counts, the context figures
//   2 — the `ctx` tag
export struct PillCell {
    text: string,
    // The widest string this cell will ever hold. The cell reserves that width
    // whatever it is currently showing, so the pill does not twitch — and
    // everything to the right of a changing digit does not shuffle.
    template: string,
    role: int,
    ink: brush,
    // 0 — an ordinary space after the cell
    // 1 — none: the cells either side read as one word
    // 2 — a short faint rule: two halves of one figure
    // 3 — the end of the group
    gap: int,
    // 0 centre, 1 against the right edge, 2 against the left
    side: int,
}

// One limit: its figures, and the hairline underneath them.
export struct PillGroup {
    cells: [PillCell],
    has_bar: bool,
    // How much of the track is filled, 0..1. Already the right way round: the
    // program decides whether the figure counts up or down.
    bar_frac: float,
    bar_ink: brush,
    // The last group draws no divider after itself.
    last: bool,
}

component Cell inherits Rectangle {
    in property <PillCell> cell;
    in property <length> size;
    in property <int> weight;

    // The wider of what is shown and what might be: see `template`.
    width: max(shown.preferred-width, ghost.preferred-width);

    ghost := Text {
        text: cell.template;
        font-size: size;
        font-family: "Segoe UI";
        font-weight: weight;
        opacity: 0;
    }

    shown := Text {
        text: cell.text;
        color: cell.ink;
        font-size: size;
        font-family: "Segoe UI";
        font-weight: weight;
        width: self.preferred-width;
        x: cell.side == 1 ? parent.width - self.width
            : cell.side == 2 ? 0px
            : (parent.width - self.width) / 2;
        vertical-alignment: center;
    }
}

export component Pill inherits Window {
    // ---- what the program sends -------------------------------------------
    in property <[PillGroup]> groups: [];
    /// The figures on screen are older than their source's threshold.
    in property <bool> stale: false;
    /// From the config, because it is a preference rather than a style: how
    /// large the whole pill is, and how much of the desktop shows through it.
    in property <float> scale: 1.0;
    in property <float> alpha: 0.88;

    // ---- what the program reads back --------------------------------------
    /// The palette, by role. The program resolves a figure's place on the
    /// green-amber-red ramp against these and sends back a finished brush, so
    /// changing a colour here changes it everywhere that colour *means*
    /// something, and nowhere else.
    out property <brush> palette_green: #6fcf97;
    out property <brush> palette_amber: #e6b65c;
    out property <brush> palette_orange: #e8994c;
    out property <brush> palette_red: #e8695e;
    out property <brush> palette_ink: #ececf0;
    out property <brush> palette_dim: #8c8e99;

    /// What the pill would like to be. The program cannot measure a string —
    /// this file lays out its own text — so the window is sized to whatever
    /// comes back here.
    out property <length> wanted_width: body.preferred-width;
    out property <length> wanted_height: max(pill_height, body.preferred-height);

    /// Bumped when the program starts sending something this file could not
    /// have known about. A mismatch is a line in the tray menu, not a refusal
    /// to start.
    out property <int> theme_api: 1;

    // ---- what the program listens for -------------------------------------
    /// Pressed with the left button: the program hands the window to the
    /// system's move loop, so the pill can be dragged from anywhere on it.
    callback pressed();
    /// Pressed with the right button: opens the settings.
    callback menu();
    /// The pointer entered or left the pill. The panel under it opens on
    /// hover, and the program is the one that knows whether it should.
    callback hovered(bool);

    // ---- the sizes this file owns -----------------------------------------
    property <length> pill_height: 34px * scale;
    property <length> pad_x: 13px * scale;
    property <length> pad_top: 4.5px * scale;
    property <length> pad_bottom: 4.5px * scale;
    property <length> gap_text_bars: 3px * scale;
    property <length> track_height: 3px * scale;
    property <length> cell_gap: 9px * scale;
    property <length> group_gap: 11px * scale;
    property <length> corner: 8px * scale;
    property <length> font_pct: 14px * scale;
    property <length> font_time: 14px * scale;
    property <length> font_small: 12px * scale;

    background: transparent;

    Rectangle {
        background: rgba(19, 19, 22, root.alpha * 255);
        border-radius: corner;
        border-width: 1px;
        border-color: #ffffff16;

        TouchArea {
            changed has-hover => {
                root.hovered(self.has-hover);
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.pressed();
                }
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                    root.menu();
                }
            }
        }

        // A quiet marker beats a confident wrong number: the figures are
        // history, and the pill says so without needing to be hovered.
        if root.stale: Rectangle {
            x: 6px * scale;
            y: parent.height / 2 - 2.5px * scale;
            width: 5px * scale;
            height: 5px * scale;
            border-radius: self.width / 2;
            background: palette_amber;
        }

        body := HorizontalLayout {
            padding-left: pad_x;
            padding-right: pad_x;
            padding-top: pad_top;
            padding-bottom: pad_bottom;
            spacing: 0px;
            alignment: start;

            for g[gi] in root.groups: HorizontalLayout {
                spacing: 0px;

                VerticalLayout {
                    spacing: gap_text_bars;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 0px;
                        for c[ci] in g.cells: HorizontalLayout {
                            spacing: 0px;
                            Cell {
                                cell: c;
                                size: c.role == 0 ? font_pct
                                    : c.role == 1 ? font_time
                                    : font_small;
                                weight: c.role == 0 ? 600 : 400;
                            }
                            // The space after a cell, and whatever goes in it.
                            Rectangle {
                                width: c.gap == 1 ? 0px
                                    : c.gap == 3 ? 0px
                                    : c.gap == 2 ? cell_gap * 1.5
                                    : cell_gap;
                                // The rule between two halves of one figure:
                                // shorter and quieter than the divider between
                                // groups, because it joins rather than
                                // separates.
                                if c.gap == 2: Rectangle {
                                    x: parent.width / 2;
                                    width: 1px;
                                    height: pill_height * 0.32;
                                    y: parent.height / 2 - self.height / 2;
                                    background: #ffffff14;
                                }
                            }
                        }
                    }

                    if g.has_bar: Rectangle {
                        height: track_height;
                        border-radius: self.height / 2;
                        background: #ffffff18;
                        Rectangle {
                            x: 0;
                            width: parent.width * g.bar_frac;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: g.bar_ink;
                        }
                    }
                }

                // The divider between two limits: two gaps with a rule down
                // the middle of them.
                if !g.last: Rectangle {
                    width: group_gap * 2;
                    Rectangle {
                        x: parent.width / 2;
                        width: 1px;
                        height: pill_height * 0.48;
                        y: parent.height / 2 - self.height / 2;
                        background: #ffffff1a;
                    }
                }
            }
        }
    }
}

// The detail panel. A window of its own rather than part of the pill, so that
// opening it cannot move the pill — which is what made the pill's size depend
// on what the pointer was over, and that was a feedback loop (G16).
export struct PanelLine {
    label: string,
    value: string,
}

export component Panel inherits Window {
    in property <[PanelLine]> lines: [];
    in property <float> scale: 1.0;
    in property <float> alpha: 0.88;

    /// The pointer is over the panel itself. Without this the panel closes the
    /// moment anyone moves onto it to read it.
    callback hovered(bool);

    out property <brush> palette_ink: #ececf0;
    out property <brush> palette_dim: #8c8e99;
    out property <length> wanted_width: box.preferred-width;
    out property <length> wanted_height: box.preferred-height;

    property <length> corner: 8px * scale;
    property <length> font: 12.5px * scale;
    property <length> gutter: 34px * scale;

    background: transparent;

    Rectangle {
        background: rgba(19, 19, 22, root.alpha * 255);
        border-radius: corner;
        border-width: 1px;
        border-color: #ffffff16;

        TouchArea {
            changed has-hover => {
                root.hovered(self.has-hover);
            }
        }

        box := VerticalLayout {
            padding: 14px * scale;
            spacing: 2px * scale;

            for l in root.lines: HorizontalLayout {
                spacing: 0px;
                Text {
                    text: l.label;
                    color: palette_dim;
                    font-size: font;
                    font-family: "Segoe UI";
                    width: gutter;
                }
                Text {
                    text: l.value;
                    color: palette_ink;
                    font-size: font;
                    font-family: "Segoe UI";
                }
            }
        }
    }
}
